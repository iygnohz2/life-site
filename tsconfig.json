{
  "compilerOptions": {
    "incremental": true,
    "target": "ES6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "composite": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "components/*"
      ],
      "@/data/*": [
        "data/*"
      ],
      "@/lib/*": [
        "lib/*"
      ],
      "@/css/*": [
        "css/*"
      ],
      "contentlayer/generated": [
        "./.contentlayer/generated"
      ],
      "pliny/*": [
        "node_modules/pliny/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "**/*.js",
    "**/*.json",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".contentlayer/generated",
    ".contentlayer/generated/**/*.json",
    ".next-b2/types/**/*.ts",
    ".next-b3/types/**/*.ts",
    ".next-b4/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-s1/types/**/*.ts",
    ".next-s2/types/**/*.ts",
    ".next-s3/types/**/*.ts",
    ".next-s4/types/**/*.ts",
    ".next-s5/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-s6/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-dev*",
    ".next-prod*",
    "_sample-content"
  ]
}
